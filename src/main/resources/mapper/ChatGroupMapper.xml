<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fishmatrix.chat.mapper.ChatGroupMapper">

  <sql id="GROUP_COLUMNS">
    id, name, description, sort_order, created_at
  </sql>

  <select id="selectAllOrdered" resultType="com.fishmatrix.chat.entity.ChatGroupEntity">
    SELECT <include refid="GROUP_COLUMNS"/>
    FROM chat_group
    ORDER BY sort_order, id
  </select>

</mapper>
